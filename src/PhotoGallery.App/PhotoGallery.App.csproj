<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>PhotoGallery.App</RootNamespace>
    <AssemblyName>HolidayPhotoGallery</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- A plain .exe (no MSIX install) that carries its own Windows App SDK runtime. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!-- Building from the command line without a platform defaults to x64. -->
  <PropertyGroup Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">
    <Platform>x64</Platform>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoGallery.Core\PhotoGallery.Core.csproj" />
  </ItemGroup>

  <!-- The app's Google Photos key, passed in by the build server (-p:GoogleClientId=… -p:GoogleClientSecret=…)
       and never kept in the code. Builds without it ask users to set up their own key. -->
  <ItemGroup Condition="'$(GoogleClientId)' != '' and '$(GoogleClientSecret)' != ''">
    <AssemblyMetadata Include="GoogleClientId" Value="$(GoogleClientId)" />
    <AssemblyMetadata Include="GoogleClientSecret" Value="$(GoogleClientSecret)" />
  </ItemGroup>
  <!-- The app's Microsoft app registration for OneDrive (-p:OneDriveClientId=…). -->
  <ItemGroup Condition="'$(OneDriveClientId)' != ''">
    <AssemblyMetadata Include="OneDriveClientId" Value="$(OneDriveClientId)" />
  </ItemGroup>

  <!-- The map page, served to WebView2 from the app folder. -->
  <ItemGroup>
    <None Remove="Assets\map.html" />
    <Content Remove="Assets\map.html" />
    <Content Include="Assets\map.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The app icon: built into the .exe (ApplicationIcon) and loaded for the title bar and taskbar. -->
  <ItemGroup>
    <None Remove="Assets\AppIcon.ico" />
    <Content Remove="Assets\AppIcon.ico" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon-40.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- The built-in languages (see PhotoGallery.Core.Localization.Strings); template.json lists every text. -->
    <None Remove="Languages\*.json" />
    <Content Include="Languages\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Ship ExifTool next to the app when scripts/Get-ExifTool.ps1 has downloaded it. -->
  <ItemGroup Condition="Exists('..\..\tools\exiftool\exiftool.exe')">
    <None Include="..\..\tools\exiftool\**\*" Link="exiftool\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
