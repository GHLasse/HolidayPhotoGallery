<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PhotoGallery.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhotoGallery.App"
    xmlns:vm="using:PhotoGallery.App.ViewModels"
    xmlns:controls="using:PhotoGallery.App.Controls"
    Title="Holiday Photo Gallery">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Toolbar: commands, search and filters. Drawn above the grid, so a face enlarged on hover shows over it. -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Padding="12,8" ColumnSpacing="8" RowSpacing="4" Canvas.ZIndex="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <CommandBar Grid.Column="0" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="False" Background="Transparent">
                <AppBarButton Icon="Add" Label="Add folder" Click="AddFolder_Click" ToolTipService.ToolTip="Add a folder to the library" />
                <AppBarButton Icon="Refresh" Label="Rescan" Click="Rescan_Click" IsEnabled="{x:Bind local:Ui.Not(ViewModel.IsBusy), Mode=OneWay}" ToolTipService.ToolTip="Look for new, changed and deleted photos" />
                <AppBarSeparator />
                <!-- Windows has one rotate arrow (clockwise); mirrored, it points counter-clockwise. -->
                <AppBarButton x:Name="RotateLeftButton" Label="Left" Click="RotateLeft_Click" ToolTipService.ToolTip="Rotate left (Ctrl+,)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <ScaleTransform ScaleX="-1" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="RotateRightButton" Label="Right" Click="RotateRight_Click" ToolTipService.ToolTip="Rotate right (Ctrl+.)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE7AD;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="Compare" Click="Compare_Click" ToolTipService.ToolTip="Show 1 to 4 selected photos side by side to rate them (C)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE89F;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Make editable" Click="MakeEditable_Click"
                              ToolTipService.ToolTip="Remove the read-only mark from all photos in the selected folder (or the whole library), e.g. after copying them from a phone">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE785;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Shift dates" Click="ShiftDates_Click" ToolTipService.ToolTip="Correct the date and time of the selected photos">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xEC92;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarToggleButton x:Name="MapToggle" Icon="Map" Label="Map" Click="Map_Click"
                                    ToolTipService.ToolTip="Show where the photos were taken, and place the selected photos on the map (M)" />
                <AppBarButton Label="Add place names" Click="AddPlaceNames_Click"
                              ToolTipService.ToolTip="Look up country, region, city and district from the GPS position of the selected photos (OpenStreetMap) and save them in the files">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE707;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Auto-tag" Click="AutoTag_Click" IsEnabled="{x:Bind local:Ui.Not(ViewModel.IsBusy), Mode=OneWay}"
                              ToolTipService.ToolTip="Recognise what is in the selected photos on this PC and add tags from your tag list, as Auto/…">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8EC;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="People" IsEnabled="{x:Bind local:Ui.Not(ViewModel.IsBusy), Mode=OneWay}"
                              ToolTipService.ToolTip="Find the people in your photos on this PC and name them">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Find people in the selected photos" Click="FindPeople_Click" />
                            <MenuFlyoutItem Text="Find people in all photos shown" Click="FindPeopleInAll_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Name the people found…" Click="NamePeople_Click" />
                            <MenuFlyoutItem Text="Add a person to the selected photos…" Click="AddPerson_Click" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton Label="Settings" Click="Settings_Click" ToolTipService.ToolTip="Settings for tagging and cropping">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="Keyboard shortcuts" Click="Shortcuts_Click" ToolTipService.ToolTip="List the keyboard shortcuts (? or F1)">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE765;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Remove auto tags" Click="RemoveAutoTags_Click" IsEnabled="{x:Bind local:Ui.Not(ViewModel.IsBusy), Mode=OneWay}"
                                  ToolTipService.ToolTip="Remove the Auto/… tags from the selected photos; your own tags stay">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE74D;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
            <!-- One filter bar: everything that narrows the grid, wrapping onto a second line when the window is narrow. -->
            <controls:WrapPanel Grid.Row="1" Grid.ColumnSpan="2">
                <AutoSuggestBox Width="260" VerticalAlignment="Center"
                                PlaceholderText="Search names, captions and tags"
                                QueryIcon="Find"
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DropDownButton VerticalAlignment="Center" ToolTipService.ToolTip="Only photos with all the ticked tags">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8EC;" FontSize="14" />
                        <TextBlock Text="Tags" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <ListView Width="300" MaxHeight="480" SelectionMode="None" ItemsSource="{x:Bind ViewModel.Tags}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TagFilterViewModel">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Content="{x:Bind Tag}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind CountText}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <!-- The five people on the most photos, with their latest face; filled from code. -->
                <StackPanel x:Name="TopPeople" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
                <DropDownButton VerticalAlignment="Center" Visibility="{x:Bind ViewModel.HasPeople, Mode=OneWay}"
                                ToolTipService.ToolTip="Everyone named, by name. Only photos with all the ticked people are shown.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE77B;" FontSize="14" />
                        <TextBlock Text="More people" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <ListView Width="300" MaxHeight="480" SelectionMode="None" ItemsSource="{x:Bind ViewModel.PeopleByName, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TagFilterViewModel">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Content="{x:Bind Tag}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind CountText}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <ComboBox VerticalAlignment="Center" MinWidth="120"
                          PlaceholderText="Rating"
                          SelectedIndex="{x:Bind ViewModel.MinRating, Mode=TwoWay}"
                          ToolTipService.ToolTip="Minimum rating">
                    <ComboBoxItem Content="Any rating" />
                    <ComboBoxItem Content="★ and up" />
                    <ComboBoxItem Content="★★ and up" />
                    <ComboBoxItem Content="★★★ and up" />
                    <ComboBoxItem Content="★★★★ and up" />
                    <ComboBoxItem Content="★★★★★" />
                </ComboBox>
                <ToggleButton VerticalAlignment="Center" IsChecked="{x:Bind ViewModel.FlaggedOnly, Mode=TwoWay}"
                              ToolTipService.ToolTip="Only flagged photos">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7C1;" FontSize="14" />
                        <TextBlock Text="Flagged" />
                    </StackPanel>
                </ToggleButton>
                <!-- Filled from code, like the time zone list: editing a bound list while x:Bind also sets
                     the index crashed the app inside WinUI. -->
                <ComboBox x:Name="CameraCombo" VerticalAlignment="Center" MinWidth="150" MaxWidth="260"
                          SelectionChanged="CameraCombo_SelectionChanged"
                          ToolTipService.ToolTip="Only photos from this camera">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CameraFilterViewModel">
                            <TextBlock Text="{x:Bind Display}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CalendarDatePicker VerticalAlignment="Center" PlaceholderText="Taken from"
                                    Date="{x:Bind ViewModel.TakenFrom, Mode=TwoWay}" />
                <CalendarDatePicker VerticalAlignment="Center" PlaceholderText="Taken until"
                                    Date="{x:Bind ViewModel.TakenTo, Mode=TwoWay}" />
                <!-- Photos that still need work: no own tags, nobody named, no GPS position. -->
                <DropDownButton VerticalAlignment="Center" ToolTipService.ToolTip="Find photos that still need tags, people or a place on the map">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D5;" FontSize="14" />
                        <TextBlock Text="Missing" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <ToggleMenuFlyoutItem Text="No tags (auto tags don't count)" IsChecked="{x:Bind ViewModel.WithoutTags, Mode=TwoWay}" />
                            <ToggleMenuFlyoutItem Text="No people named" IsChecked="{x:Bind ViewModel.WithoutPeople, Mode=TwoWay}" />
                            <ToggleMenuFlyoutItem Text="No location" IsChecked="{x:Bind ViewModel.WithoutLocation, Mode=TwoWay}" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button VerticalAlignment="Center" Content="Clear filters" Click="ClearFilters_Click" />
                <!-- The ticked tags and people as badges, each with × to drop it from the filter. -->
                <controls:WrapPanel x:Name="FilterBadges" VerticalAlignment="Center" />
            </controls:WrapPanel>
        </Grid>

        <!-- Messages as banners, newest first; filled from code when ViewModel.Notices changes. -->
        <StackPanel x:Name="NoticePanel" Grid.Row="1" Grid.ColumnSpan="3" Margin="12,0,12,0" Spacing="4" />

        <!-- Navigation: folders (tags and people are in the filter bar) -->
        <Grid Grid.Row="2" Grid.Column="0" Padding="8,0,0,8" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Grid.Row="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="AllPhotos_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE91B;" FontSize="16" />
                    <TextBlock Text="All photos" />
                </StackPanel>
            </Button>
            <Grid Grid.Row="1">
                <TextBlock Margin="8" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind ViewModel.HasNoFolders, Mode=OneWay}"
                           Text="Add a folder with your photos to get started. Your files stay where they are." />
                <TreeView x:Name="FolderTree" SelectionMode="Single"
                          ItemsSource="{x:Bind ViewModel.Folders}"
                          ItemInvoked="FolderTree_ItemInvoked"
                          Expanding="FolderTree_Expanding">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FolderNodeViewModel">
                            <TreeViewItem ItemsSource="{x:Bind Children}"
                                          AutomationProperties.Name="{x:Bind Name}"
                                          ToolTipService.ToolTip="{x:Bind FullPath}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
            <Button Grid.Row="2" Content="Remove folder from library" HorizontalAlignment="Stretch"
                    IsEnabled="{x:Bind local:Ui.IsRootFolder(ViewModel.SelectedFolder), Mode=OneWay}"
                    Click="RemoveFolder_Click"
                    ToolTipService.ToolTip="Stops showing this folder. No files are deleted." />
        </Grid>

        <!-- Photo grid -->
        <Grid Grid.Row="2" Grid.Column="1" Margin="8,0,8,8" RowSpacing="4" ColumnSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- The map, next to the grid like in Geosetter; opened with the Map button. -->
                <ColumnDefinition x:Name="MapColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.ColumnSpan="2" Margin="4,0" Text="{x:Bind local:Ui.FolderHeader(ViewModel.SelectedFolder), Mode=OneWay}"
                       Style="{ThemeResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            <GridView x:Name="PhotoGrid" Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Photos, Mode=OneWay}"
                      SelectionMode="Extended"
                      SelectionChanged="PhotoGrid_SelectionChanged"
                      ContainerContentChanging="PhotoGrid_ContainerContentChanging"
                      DoubleTapped="PhotoGrid_DoubleTapped"
                      KeyDown="PhotoGrid_KeyDown">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PhotoItemViewModel">
                        <Grid Width="180" Height="180" CornerRadius="4"
                              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                              ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
                            <FontIcon Glyph="&#xEB9F;" FontSize="32" Opacity="0.3" />
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" Margin="4,4,4,24" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="4" CornerRadius="4"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind FlagVisibility, Mode=OneWay}"
                                    ToolTipService.ToolTip="Flagged">
                                <FontIcon Glyph="&#xE7C1;" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                            <Grid VerticalAlignment="Bottom" Height="22" Padding="6,0" ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind FileName}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Stars, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <controls:MapPanel x:Name="MapView" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" />
        </Grid>

        <!-- Metadata panel -->
        <ScrollViewer Grid.Row="2" Grid.Column="2" Padding="8,0,16,8">
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind ViewModel.Editor.Summary, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.Editor.Details, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Editor.HasSelection, Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Rating" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <RatingControl VerticalAlignment="Center" IsClearEnabled="True"
                                           Value="{x:Bind ViewModel.Editor.Rating, Mode=TwoWay}" />
                            <!-- Written straight away, like the P key; filled from the selection in code. -->
                            <ToggleButton x:Name="FlagButton" VerticalAlignment="Center" Click="Flag_Click" ToolTipService.ToolTip="Flag or unflag the selected photos (P)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7C1;" FontSize="14" />
                                    <TextBlock Text="Flag" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </StackPanel>
                    <TextBox Header="Caption" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                             PlaceholderText="{x:Bind ViewModel.Editor.CaptionPlaceholder, Mode=OneWay}"
                             Text="{x:Bind ViewModel.Editor.Caption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- Badges filled from code (MainWindow.Tags.cs) whenever Editor.Tags changes. -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Tags" />
                        <controls:WrapPanel x:Name="TagBadges" />
                        <AutoSuggestBox x:Name="TagBox" PlaceholderText="Add a tag" QueryIcon="Add"
                                        TextChanged="TagBox_TextChanged" SuggestionChosen="TagBox_SuggestionChosen"
                                        QuerySubmitted="TagBox_QuerySubmitted" />
                        <TextBlock x:Name="TagHint" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <!-- Filled from code with one row per face (MainWindow.People.cs); only for a single photo. -->
                    <StackPanel x:Name="PeopleSection" Spacing="6" Visibility="Collapsed">
                        <TextBlock Text="People" />
                        <StackPanel x:Name="PeopleList" Spacing="6" />
                        <TextBlock x:Name="PeopleHint" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Editor.IsSingle, Mode=OneWay}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Date taken" PlaceholderText="2024-07-01 14:30:00"
                                     Text="{x:Bind ViewModel.Editor.DateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <!-- Filled from code: binding both the list and the index let x:Bind set the index first, which crashed at startup. -->
                            <ComboBox x:Name="TimeZoneCombo" Grid.Row="1" Grid.ColumnSpan="2" Header="Time zone" HorizontalAlignment="Stretch"
                                      SelectionChanged="TimeZoneCombo_SelectionChanged" />
                        </Grid>
                        <TextBlock Text="The camera's local time, and where it was taken. Summer time is worked out from the date."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Editor.ValidationError, Mode=OneWay}" TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{ThemeResource AccentButtonStyle}" Content="Save" Click="Save_Click"
                                IsEnabled="{x:Bind ViewModel.Editor.IsDirty, Mode=OneWay}"
                                ToolTipService.ToolTip="Write the changes into the files (Ctrl+S)">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="S" />
                            </Button.KeyboardAccelerators>
                        </Button>
                        <Button Content="Discard" Click="Discard_Click" IsEnabled="{x:Bind ViewModel.Editor.IsDirty, Mode=OneWay}" />
                        <Button Content="Show in folder" Click="ShowInFolder_Click" IsEnabled="{x:Bind ViewModel.Editor.IsSingle, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Text="Changes are also saved when you select other photos."
                               TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Status bar -->
        <Grid Grid.Row="3" Grid.ColumnSpan="3" Padding="12,4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <ProgressBar Grid.Column="1" IsIndeterminate="True" VerticalAlignment="Center"
                         Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </Grid>

        <!-- Full-size viewer, shown over everything -->
        <Grid x:Name="ViewerLayer" Grid.RowSpan="4" Grid.ColumnSpan="3" Visibility="Collapsed"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Padding="12,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ViewerTitle" VerticalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Click="ViewerRotateLeft_Click" ToolTipService.ToolTip="Rotate left">
                        <FontIcon Glyph="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <ScaleTransform ScaleX="-1" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Button>
                    <Button Click="ViewerRotateRight_Click" ToolTipService.ToolTip="Rotate right">
                        <FontIcon Glyph="&#xE7AD;" />
                    </Button>
                    <AppBarSeparator />
                    <ToggleButton x:Name="ViewerCropButton" Click="ViewerCrop_Click" ToolTipService.ToolTip="Crop">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7A8;" FontSize="16" />
                            <TextBlock Text="Crop" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="ViewerAutoButton" Click="ViewerAuto_Click" ToolTipService.ToolTip="Adjust contrast and brightness automatically">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE706;" FontSize="16" />
                            <TextBlock Text="Auto adjust" />
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="ViewerUndoButton" Click="ViewerUndo_Click" IsEnabled="False" ToolTipService.ToolTip="Undo the last saved edit of this photo">
                        <FontIcon Glyph="&#xE7A7;" />
                    </Button>
                    <Button x:Name="ViewerRevertButton" Click="ViewerRevert_Click" IsEnabled="False" ToolTipService.ToolTip="Go back to the original photo, before any edits">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE81C;" FontSize="16" />
                            <TextBlock Text="Revert" />
                        </StackPanel>
                    </Button>
                    <AppBarSeparator />
                    <Button x:Name="ViewerCloseButton" Click="ViewerClose_Click" ToolTipService.ToolTip="Back to the gallery (Esc)">
                        <SymbolIcon Symbol="Cancel" />
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Escape" Invoked="ViewerAccelerator_Invoked" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </StackPanel>
            </Grid>
            <controls:EditCanvas x:Name="ViewerCanvas" Grid.Row="1" Margin="56,0,56,16" />
            <ProgressRing x:Name="ViewerProgress" Grid.Row="1" IsActive="False" />
            <TextBlock x:Name="ViewerError" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480" />
            <Button Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8" Click="ViewerPrevious_Click" ToolTipService.ToolTip="Previous (Left arrow)">
                <SymbolIcon Symbol="Back" />
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Left" Invoked="ViewerAccelerator_Invoked" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8" Click="ViewerNext_Click" ToolTipService.ToolTip="Next (Right arrow)">
                <SymbolIcon Symbol="Forward" />
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Right" Invoked="ViewerAccelerator_Invoked" />
                </Button.KeyboardAccelerators>
            </Button>
            <!-- Shown while a crop or auto adjust is being previewed; nothing is written before Save. -->
            <Grid x:Name="ViewerEditBar" Grid.Row="2" Padding="12,8" ColumnSpacing="8" Visibility="Collapsed"
                  Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Filled from code (CropRatios), starting with the shape chosen in Settings. -->
                <StackPanel x:Name="CropShapePanel" Orientation="Horizontal" Spacing="4">
                    <ComboBox x:Name="CropRatioCombo" VerticalAlignment="Center" MinWidth="130" MaxWidth="320"
                              SelectionChanged="CropRatio_SelectionChanged" ToolTipService.ToolTip="Shape of the crop" />
                    <ToggleButton x:Name="CropTurnButton" VerticalAlignment="Center" Click="CropTurn_Click"
                                  ToolTipService.ToolTip="Turn the crop between landscape and portrait">
                        <FontIcon Glyph="&#xE8AB;" FontSize="14" />
                    </ToggleButton>
                </StackPanel>
                <TextBlock x:Name="ViewerEditHint" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox x:Name="SaveFormatCombo" Grid.Column="2" VerticalAlignment="Center" MinWidth="150" SelectedIndex="0"
                          ToolTipService.ToolTip="Save in the photo's own format, or as JPEG for sharing">
                    <ComboBoxItem Content="Original format" />
                    <ComboBoxItem Content="Save as JPEG" />
                </ComboBox>
                <Button Grid.Column="3" Style="{ThemeResource AccentButtonStyle}" Content="Save" Click="ViewerSaveEdit_Click"
                        ToolTipService.ToolTip="Write the edit into the photo; the original is kept in the hidden .originals folder" />
                <Button Grid.Column="4" Content="Cancel" Click="ViewerCancelEdit_Click" />
            </Grid>
        </Grid>

        <!-- Compare view for picking the best photos -->
        <controls:CompareView x:Name="CompareLayer" Grid.RowSpan="4" Grid.ColumnSpan="3" Visibility="Collapsed" />
    </Grid>
</Window>
