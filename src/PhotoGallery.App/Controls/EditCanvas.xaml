<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PhotoGallery.App.Controls.EditCanvas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The photo, fitted into the space, with the crop frame drawn over it while cropping. The mouse wheel
         zooms it, and zoomed in it is dragged around (EditCanvas.xaml.cs). -->
    <Grid x:Name="Host" SizeChanged="Host_SizeChanged" Background="Transparent"
          PointerWheelChanged="Host_PointerWheelChanged" PointerPressed="Host_PointerPressed" PointerMoved="Host_PointerMoved"
          PointerReleased="Host_PointerReleased" PointerCaptureLost="Host_PointerCaptureLost" DoubleTapped="Host_DoubleTapped">
        <Grid x:Name="Frame" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="Zoom" />
            </Grid.RenderTransform>
            <Image x:Name="Picture" Stretch="Fill" />
            <!-- A fine grid to line the horizon up with while straightening (E-14), built in code. -->
            <Grid x:Name="FineGrid" IsHitTestVisible="False" Visibility="Collapsed" />
            <Canvas x:Name="Overlay" Visibility="Collapsed" Background="Transparent"
                    PointerPressed="Overlay_PointerPressed" PointerMoved="Overlay_PointerMoved"
                    PointerReleased="Overlay_PointerReleased" PointerCaptureLost="Overlay_PointerCaptureLost">
                <Rectangle x:Name="ShadeTop" Fill="#99000000" />
                <Rectangle x:Name="ShadeBottom" Fill="#99000000" />
                <Rectangle x:Name="ShadeLeft" Fill="#99000000" />
                <Rectangle x:Name="ShadeRight" Fill="#99000000" />
                <!-- Golden ratio lines (at 38.2 % and 61.8 %) to place the subject on. -->
                <Rectangle x:Name="GoldenLeft" Fill="#B3FFFFFF" IsHitTestVisible="False" />
                <Rectangle x:Name="GoldenRight" Fill="#B3FFFFFF" IsHitTestVisible="False" />
                <Rectangle x:Name="GoldenTop" Fill="#B3FFFFFF" IsHitTestVisible="False" />
                <Rectangle x:Name="GoldenBottom" Fill="#B3FFFFFF" IsHitTestVisible="False" />
                <Rectangle x:Name="CropFrame" Stroke="White" StrokeThickness="2" />
                <Rectangle x:Name="HandleTopLeft" Width="14" Height="14" Fill="White" Stroke="#99000000" />
                <Rectangle x:Name="HandleTopRight" Width="14" Height="14" Fill="White" Stroke="#99000000" />
                <Rectangle x:Name="HandleBottomLeft" Width="14" Height="14" Fill="White" Stroke="#99000000" />
                <Rectangle x:Name="HandleBottomRight" Width="14" Height="14" Fill="White" Stroke="#99000000" />
            </Canvas>
            <!-- Retouching (E-11): the brush follows the pointer and a stroke shows where it went until it is applied.
                 It lies over the crop frame, which takes the pointer again when no retouch tool is chosen. -->
            <!-- Strokes the eraser is still working on shimmer here until their fill is shown. -->
            <Canvas x:Name="WorkingLayer" IsHitTestVisible="False" />
            <Canvas x:Name="PaintLayer" Visibility="Collapsed" Background="Transparent"
                    PointerPressed="PaintLayer_PointerPressed" PointerMoved="PaintLayer_PointerMoved"
                    PointerReleased="PaintLayer_PointerReleased" PointerCaptureLost="PaintLayer_PointerCaptureLost"
                    PointerExited="PaintLayer_PointerExited">
                <Polyline x:Name="StrokeLine" Stroke="#80FF4081" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" IsHitTestVisible="False" />
                <Ellipse x:Name="BrushRing" Stroke="White" IsHitTestVisible="False" Visibility="Collapsed" />
                <Ellipse x:Name="BrushRingShade" Stroke="#99000000" IsHitTestVisible="False" Visibility="Collapsed" />
            </Canvas>
        </Grid>
    </Grid>
</UserControl>
