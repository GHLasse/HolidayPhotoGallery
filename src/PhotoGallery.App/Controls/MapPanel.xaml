<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PhotoGallery.App.Controls.MapPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhotoGallery.App">

    <!-- The map fills the pane and the controls float over it, like a navigation app (Lasse 2026-11-07): Map | Satellite
         as a pill like the Details | Map | Edit switch, a layers button for Labels and Tracks, and one bar at the bottom
         with the pin and Assign; Estimate again and Remove location, both rare, sit in its … menu. WinUI draws its own
         controls over the WebView2. -->
    <Grid>
        <Grid.Resources>
            <!-- Floating over the map: solid enough to read on any map, with a soft shadow. -->
            <Style x:Key="FloatingCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </Grid.Resources>
        <!-- An accent swatch the map page is coloured from ({type:"style"}); it follows the palette and light/dark. -->
        <Border x:Name="AccentProbe" Width="0" Height="0" Background="{ThemeResource AccentFillColorDefaultBrush}"
                BorderBrush="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        <!-- Edge to edge, beside the photos and on the Map page alike: no border, no rounded corners. -->
        <WebView2 x:Name="Web" />

        <!-- Top right, under the map's search box: Map | Satellite and the layers button. -->
        <StackPanel x:Name="TopControls" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,56,10,0">
            <Grid x:Name="ModeSwitch" Height="32">
                <Grid.Resources>
                    <!-- No hover or pressed fill of their own: the thumb shows which one is on. -->
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                </Grid.Resources>
                <Border Style="{StaticResource FloatingCard}" CornerRadius="16" />
                <Border x:Name="ModeThumb" Height="26" Margin="3,0,0,0" CornerRadius="13" HorizontalAlignment="Left"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <Border.TranslationTransition>
                        <Vector3Transition Duration="0:0:0.167" />
                    </Border.TranslationTransition>
                </Border>
                <StackPanel x:Name="ModeButtons" Orientation="Horizontal" Margin="3,0">
                    <Button x:Name="StreetMapButton" Click="MapMode_Click" Height="26" Padding="12,0" CornerRadius="13"
                            Background="Transparent" BorderThickness="0" SizeChanged="ModeButton_SizeChanged">
                        <Grid>
                            <TextBlock x:Name="StreetMapTextOff" Text="{local:Loc Text='Map'}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="StreetMapTextOn" Text="{local:Loc Text='Map'}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Opacity="0" />
                        </Grid>
                    </Button>
                    <Button x:Name="SatelliteButton" Click="MapMode_Click" Height="26" Padding="12,0" CornerRadius="13"
                            Background="Transparent" BorderThickness="0" SizeChanged="ModeButton_SizeChanged">
                        <Grid>
                            <TextBlock x:Name="SatelliteTextOff" Text="{local:Loc Text='Satellite'}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="SatelliteTextOn" Text="{local:Loc Text='Satellite'}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Opacity="0" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
            <Grid Width="32" Height="32">
                <Border Style="{StaticResource FloatingCard}" CornerRadius="16" />
                <Button x:Name="LayersButton" Width="32" Height="32" Padding="0" CornerRadius="16" Background="Transparent" BorderThickness="0"
                        AutomationProperties.Name="{local:Loc Text='Map options'}" ToolTipService.ToolTip="{local:Loc Text='Map options'}">
                    <FontIcon Glyph="&#xE81E;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <ToggleMenuFlyoutItem x:Name="LabelsItem" Text="{local:Loc Text='Labels'}" Click="MapLayer_Click"
                                                  ToolTipService.ToolTip="{local:Loc Text='Names of places, roads and borders'}" />
                            <ToggleMenuFlyoutItem x:Name="TracksItem" Text="{local:Loc Text='Tracks'}" Click="MapLayer_Click" IsChecked="True"
                                                  ToolTipService.ToolTip="{local:Loc Text='Show the GPS tracks of the photos’ time, or the route between them. Add tracks in Settings › GPS tracks.'}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Placing photos needs the grid to pick them in, so the Map workspace hides this bar. Its height is sent to
             the page, which lifts the legend and the credits above it. -->
        <Border x:Name="AssignRow" Style="{StaticResource FloatingCard}" CornerRadius="8" Padding="10,8" Margin="10"
                VerticalAlignment="Bottom" SizeChanged="AssignRow_SizeChanged">
            <StackPanel Spacing="8">
                <TextBlock x:Name="PinText" TextWrapping="Wrap" FontSize="12" MaxLines="3" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{local:Loc Text='Click the map or search for a place to set a pin.'}" />
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AssignButton" Style="{ThemeResource AccentButtonStyle}" IsEnabled="False" HorizontalAlignment="Stretch"
                            Click="Assign_Click" ToolTipService.ToolTip="{local:Loc Text='Write the pin’s position into the selected photos'}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Width="16" Height="16"><PathIcon x:Name="AssignIcon" Width="20" Height="20" /></Viewbox>
                            <TextBlock x:Name="AssignText" Text="{local:Loc Text='Assign to selected'}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MoreButton" Grid.Column="1" AutomationProperties.Name="{local:Loc Text='More'}"
                            ToolTipService.ToolTip="{local:Loc Text='More'}">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedRight">
                                <MenuFlyoutItem x:Name="EstimateItem" Text="{local:Loc Text='Estimate from photos before and after'}" Click="Estimate_Click" IsEnabled="False"
                                                ToolTipService.ToolTip="{local:Loc Text='Estimate where the selected photos were taken from the geotagged photos before and after them'}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="RemoveItem" Text="{local:Loc Text='Remove location'}" Click="Remove_Click" IsEnabled="False"
                                                ToolTipService.ToolTip="{local:Loc Text='Delete the GPS position from the selected photos'}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
