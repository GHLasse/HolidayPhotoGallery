<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PhotoGallery.App.Controls.MapPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhotoGallery.App">

    <!-- Laid out like the Details and Edit panes: the map as a card, then native controls in the app's own style
         (the map's display choices moved out of the web page into the Map options menu, Lasse 2026-11-06). -->
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- An accent swatch the map page is coloured from ({type:"style"}); it follows the palette and light/dark. -->
        <Border x:Name="AccentProbe" Width="0" Height="0" Background="{ThemeResource AccentFillColorDefaultBrush}"
                BorderBrush="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <WebView2 x:Name="Web" />
        </Border>

        <!-- The pin (or what the estimate found) on the left, the map's display choices on the right. -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PinText" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{local:Loc Text='Click the map or search for a place to set a pin.'}" />
            <DropDownButton x:Name="MapOptionsButton" Grid.Column="1" AutomationProperties.Name="{local:Loc Text='Map options'}"
                            ToolTipService.ToolTip="{local:Loc Text='Map options'}">
                <FontIcon Glyph="&#xE81E;" FontSize="16" />
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedRight">
                        <RadioMenuFlyoutItem x:Name="StreetMapItem" GroupName="MapMode" Text="{local:Loc Text='Map'}" Click="MapMode_Click" />
                        <RadioMenuFlyoutItem x:Name="SatelliteItem" GroupName="MapMode" Text="{local:Loc Text='Satellite'}" Click="MapMode_Click" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem x:Name="LabelsItem" Text="{local:Loc Text='Labels'}" Click="MapLayer_Click"
                                              ToolTipService.ToolTip="{local:Loc Text='Names of places, roads and borders'}" />
                        <ToggleMenuFlyoutItem x:Name="TracksItem" Text="{local:Loc Text='Tracks'}" Click="MapLayer_Click" IsChecked="True"
                                              ToolTipService.ToolTip="{local:Loc Text='Show the GPS tracks of the photos’ time, or the route between them. Add tracks in Settings › GPS tracks.'}" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!-- Placing photos needs the grid to pick them in, so the Map workspace hides this row. Assign leads and takes
             the room; in a narrow pane Estimate and Remove show only their icons (FitButtons). Icons from AppIcons. -->
        <Grid x:Name="AssignRow" Grid.Row="2" ColumnSpacing="6" SizeChanged="AssignRow_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="AssignButton" Style="{ThemeResource AccentButtonStyle}" IsEnabled="False" HorizontalAlignment="Stretch"
                    Click="Assign_Click" ToolTipService.ToolTip="{local:Loc Text='Write the pin’s position into the selected photos'}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Viewbox Width="16" Height="16"><PathIcon x:Name="AssignIcon" Width="20" Height="20" /></Viewbox>
                    <TextBlock x:Name="AssignText" Text="{local:Loc Text='Assign to selected'}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
            <Button x:Name="EstimateButton" Grid.Column="1" IsEnabled="False" Click="Estimate_Click" AutomationProperties.Name="{local:Loc Text='Estimate'}"
                    ToolTipService.ToolTip="{local:Loc Text='Estimate where the selected photos were taken from the geotagged photos before and after them'}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Viewbox Width="16" Height="16"><PathIcon x:Name="EstimateIcon" Width="20" Height="20" /></Viewbox>
                    <TextBlock x:Name="EstimateLabel" Text="{local:Loc Text='Estimate'}" />
                </StackPanel>
            </Button>
            <Button x:Name="RemoveButton" Grid.Column="2" IsEnabled="False" Click="Remove_Click" AutomationProperties.Name="{local:Loc Text='Remove location'}"
                    ToolTipService.ToolTip="{local:Loc Text='Delete the GPS position from the selected photos'}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Viewbox Width="16" Height="16"><PathIcon x:Name="RemoveIcon" Width="20" Height="20" /></Viewbox>
                    <TextBlock x:Name="RemoveLabel" Text="{local:Loc Text='Remove location'}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
